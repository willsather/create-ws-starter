{
  "name": "create-ws-starter",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willsather/create-ws-starter.git",
    "directory": "cli"
  },
  "homepage": "https://create.sather.ws",
  "publishConfig": {
    "provenance": true
  },
  "bin": {
    "create-ws-starter": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "license": "MIT",
  "keywords": [
    "nextjs",
    "turborepo",
    "turbo",
    "shadcn",
    "tailwind",
    "typescript"
  ],
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc -p tsconfig.build.json",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "execa": "10.2.1",
    "fs-extra": "11.4.1",
    "type-fest": "5.10.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  }
}
