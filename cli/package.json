{
  "name": "create-ws-starter",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willsather/create-ws-starter.git",
    "directory": "cli"
  },
  "homepage": "https://create.sather.ws",
  "publishConfig": {
    "provenance": true
  },
  "bin": {
    "create-ws-starter": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "license": "MIT",
  "keywords": [
    "nextjs",
    "turborepo",
    "turbo",
    "shadcn",
    "tailwind",
    "typescript"
  ],
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "fs-extra": "11.4.0",
    "type-fest": "5.8.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.3.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.x"
  }
}
