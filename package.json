{
  "name": "@ws/root",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:cli": "turbo dev --filter=create-ws-starter",
    "dev:web": "turbo dev --filter=@ws/web",
    "build": "turbo build",
    "build:cli": "turbo build --filter=create-ws-starter",
    "build:web": "turbo build --filter=@ws/web",
    "start": "turbo start",
    "start:cli": "turbo start --filter=create-ws-starter",
    "start:web": "turbo start --filter=@ws/web",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "changeset": "changeset",
    "release": "turbo build && changeset publish",
    "version-packages": "changeset version && pnpm i --no-frozen-lockfile && git add ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@ws/typescript-config": "workspace:*",
    "turbo": "2.10.12"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.x"
  }
}
